{
  "name": "@dsh-plugin/dsh-network-settings",
  "version": "2.0.0",
  "description": "Network policies for dsh: User-Agent rewriting, HTTP/CONNECT/SOCKS5 proxy and retries, configured through dsh-loader 2.0 templates.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-plugins/dsh-network-settings.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh_CN.md",
    "LICENSE",
    "docs"
  ],
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.ts",
    "prepack": "npm run build",
    "test:launch:prepare": "node scripts/prepare-launch.mjs",
    "test:launch": "node scripts/test-launch.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "user-agent",
    "proxy",
    "socks5",
    "http",
    "retry",
    "network"
  ],
  "license": "MIT",
  "dependencies": {
    "schemastery": "^3.18.0"
  },
  "peerDependencies": {
    "@dsh-plugin/dsh-loader": "^2.0.0"
  },
  "devDependencies": {
    "@dsh-plugin/dsh-loader": "file:../dsh-loader",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}
